mesa: check the LLVM execution engine was built before using it

Why: lp_build_create_jit_compiler_for_module() dereferences builder.create()'s
result without checking it, so a failure to construct the execution engine
becomes a null dereference rather than an error return.
`llvm-0001-allow-static-execution-engine.patch` removes the cause this build
actually hit; this removes the unchecked use behind it.

What: take the function's existing cleanup-and-fail path when create() yields
no engine.

diff --git a/src/gallium/auxiliary/gallivm/lp_bld_misc.cpp b/src/gallium/auxiliary/gallivm/lp_bld_misc.cpp
--- a/src/gallium/auxiliary/gallivm/lp_bld_misc.cpp
+++ b/src/gallium/auxiliary/gallivm/lp_bld_misc.cpp
@@ -576,6 +576,10 @@ lp_build_create_jit_compiler_for_module(LLVMExecutionEngineRef *OutJIT,
 
    JIT = builder.create();
 
+   if (!JIT) {
+      goto fail;
+   }
+
    if (cache_out) {
       LPObjectCache *objcache = new LPObjectCache(cache_out);
       JIT->setObjectCache(objcache);
@@ -589,6 +593,7 @@ lp_build_create_jit_compiler_for_module(LLVMExecutionEngineRef *OutJIT,
       *OutJIT = wrap(JIT);
       return 0;
    }
+fail:
    lp_free_generated_code(*OutCode);
    *OutCode = 0;
    delete MM;
